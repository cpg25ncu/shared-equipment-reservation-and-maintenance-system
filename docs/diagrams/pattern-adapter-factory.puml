// Wrapped identifiers concatenate to exact type names. Baseline df9033f.

graph [rankdir=TB,dpi=72,bgcolor=white,fontname="Arial",fontcolor="#023E7C",fontsize=22,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="24"><B>Adapter (implemented)</B></FONT></TD></TR></TABLE>>,labelloc=t,pad=0.08,nodesep=0.11,ranksep=0.11,splines=polyline,newrank=true];
node [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C"];
edge [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C",arrowsize=0.8,penwidth=1.3];
ms [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Client»</I></TD></TR><TR><TD>MaintenanceService</TD></TR></TABLE>>];
as [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Client»</I></TD></TR><TR><TD>ApprovalService</TD></TR></TABLE>>];
targetHeader [shape=plain,label="«Target» ports"]; adapterHeader [shape=plain,label="«Adapter»"];
mlp [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>MaintenanceLoan<BR/>Port</TD></TR></TABLE>>];
emp [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>Equipment<BR/>MaintenancePort</TD></TR></TABLE>>];
tdp [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>TechnicianDirectory<BR/>Port</TD></TR></TABLE>>];
rap [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>ReservationApproval<BR/>Port</TD></TR></TABLE>>];
jml [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>JdbcMaintenanceLoan<BR/>Adapter</TD></TR></TABLE>>];
jem [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>JdbcEquipment<BR/>MaintenanceAdapter</TD></TR></TABLE>>];
jtd [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>JdbcTechnician<BR/>DirectoryAdapter</TD></TR></TABLE>>];
raa [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>ReservationApproval<BR/>Adapter</TD></TR></TABLE>>];
jdbc [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Adaptee · Spring»</I></TD></TR><TR><TD>JdbcOperations</TD></TR></TABLE>>];
rs [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Adaptee»</I></TD></TR><TR><TD>ReservationApproval<BR/>Service</TD></TR></TABLE>>];
{rank=same;ms;as;} {rank=same;targetHeader;adapterHeader;} {rank=same;mlp;jml;} {rank=same;emp;jem;} {rank=same;tdp;jtd;} {rank=same;rap;raa;} {rank=same;jdbc;rs;}
ms -> targetHeader [style=invis]; as -> adapterHeader [style=invis];
targetHeader -> mlp -> emp -> tdp -> rap [style=invis,weight=100]; adapterHeader -> jml -> jem -> jtd -> raa [style=invis,weight=100];
ms -> {mlp emp tdp} [style=dashed,constraint=false]; as -> rap [style=dashed,constraint=false];
mlp -> jml [dir=back,arrowtail=empty,style=dashed,constraint=false]; emp -> jem [dir=back,arrowtail=empty,style=dashed,constraint=false]; tdp -> jtd [dir=back,arrowtail=empty,style=dashed,constraint=false]; rap -> raa [dir=back,arrowtail=empty,style=dashed,constraint=false];
rap -> jdbc [style=invis]; raa -> rs [style=dashed]; {jml jem jtd} -> jdbc [style=dashed,constraint=false];
}
@enddot

