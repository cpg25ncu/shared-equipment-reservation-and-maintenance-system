ec [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>EmailChannel</TD></TR></TABLE>>];
