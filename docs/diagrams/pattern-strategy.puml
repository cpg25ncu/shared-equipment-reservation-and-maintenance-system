@startdot
digraph UML {
// T3 UML class diagram. Render trusted source with PlantUML 1.2026.9 to SVG; rasterize to PNG.
// Wrapped identifiers concatenate to exact type names. Baseline df9033f.

graph [rankdir=LR,dpi=72,bgcolor=white,fontname="Arial",fontcolor="#023E7C",fontsize=22,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="24"><B>UC01 — Strategy</B></FONT></TD></TR><TR><TD><FONT COLOR="#F17D00"><B>Runs ALL policies; collects every violation.</B></FONT></TD></TR></TABLE>>,labelloc=t,pad=0.08,nodesep=0.11,ranksep=0.32,splines=polyline,newrank=true];
node [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C"];
edge [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C",arrowsize=0.8,penwidth=1.3];
client [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Client»</I></TD></TR><TR><TD>ReservationService</TD></TR></TABLE>>];
context [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Context»</I></TD></TR><TR><TD>ReservationRules</TD></TR><HR/><TR><TD ALIGN="LEFT">+ evaluate(ReservationRuleContext):<BR/>List&lt;RuleViolation&gt;</TD></TR></TABLE>>];
strategy [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Strategy · interface»</I></TD></TR><TR><TD>ReservationPolicy</TD></TR><HR/><TR><TD ALIGN="LEFT">+ evaluate(ReservationRuleContext):<BR/>Optional&lt;RuleViolation&gt;</TD></TR></TABLE>>];
subgraph cluster_concrete {label="«ConcreteStrategy»"; color="#023E7C"; fontcolor="#023E7C"; fontsize=22; penwidth=1; margin=10;
horizon [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>BookingHorizonPolicy</TD></TR></TABLE>>];
duration [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>DurationPolicy</TD></TR></TABLE>>];
quota [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>OpenReservationQuotaPolicy</TD></TR></TABLE>>];
overdue [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>OverdueLoanPolicy</TD></TR></TABLE>>];
future [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD>StartInFuturePolicy</TD></TR></TABLE>>];
{rank=same; horizon; duration; quota; overdue; future;}
horizon -> duration -> quota -> overdue -> future [style=invis,weight=100];
}
{rank=same; client; context; strategy;}
client -> context -> strategy [style=invis,weight=100];
client:s -> context:n [style=dashed,constraint=false];
context:s -> strategy:n [arrowtail=odiamond,dir=both,constraint=false,label="policies *"];
strategy -> {horizon duration quota overdue future} [dir=back,arrowtail=empty,style=dashed];


}
@enddot
