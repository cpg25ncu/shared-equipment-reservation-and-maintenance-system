    direction LR
    subgraph LEFT[" "]
      direction TB
      SEC["<b>Security</b><br/>★ Secrets scan (gitleaks)<br/>full history<br/>★ Vulnerability scan (Trivy)<br/>fs: vuln / misconfig / secret<br/>★ Dependency review"]
      FE["<b>Frontend &amp; contract</b><br/>★ frontend<br/>lint · typecheck · Vitest · build<br/>OpenAPI drift · Playwright"]
      REL["<b>Release preparation</b><br/>deploy script tests · Compose config<br/>Docker build app + web<br/>Trivy image scans<br/>production-profile Compose smoke"]
      SEC ~~~ FE ~~~ REL
    end
    subgraph RIGHT[" "]
      direction TB
      BUILD["<b>Build &amp; test</b><br/>Maven verify · JaCoCo ≥70%<br/>service + domain coverage<br/>PostgreSQL 18 integration:<br/>approval · maintenance · UC03<br/>notification contract<br/>Sprint 1 database migrations<br/>★ java-tests · ★ database-test<br/>★ checkout-return<br/>★ notification-contract"]
