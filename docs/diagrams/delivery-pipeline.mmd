  subgraph MAIN["2 · Merge to protected main"]
    direction TB
    DEP["<b>Deploy workflow</b><br/>docs-only pushes skipped"]
    GATE["<b>Release gate</b><br/>scripts/verify-release.mjs<br/>all 15 checks green<br/>exact current main SHA<br/>production ready"]
    APPROVE["<b>Production environment</b><br/>manual approval"]
