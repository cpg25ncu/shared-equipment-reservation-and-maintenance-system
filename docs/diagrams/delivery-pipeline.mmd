    RUN["<b>scripts/deploy.sh</b><br/>1. flock lock<br/>2. pg_dump pre-release backup<br/>+ verify archive<br/>3. checkout exact SHA<br/>4. docker compose build<br/>5. up --wait<br/>6. /api/v1/health UP"]
    NOTE["<b>Images built on the server</b><br/>No registry"]
    DEP --> GATE --> APPROVE --> SSH --> RUN
    RUN ~~~ NOTE
  end

  subgraph AFTER["3 · After release<br/>(manual)"]
    direction TB
    ZAP["OWASP ZAP<br/>baseline"]
    ACCEPT["Deployed<br/>acceptance"]
    ZAP ~~~ ACCEPT
  end

  PR --> MAIN --> AFTER
