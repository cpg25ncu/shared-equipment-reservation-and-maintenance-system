---
config:
  theme: base
  fontFamily: Arial, Helvetica, sans-serif
  themeCSS: '.nodeLabel, .edgeLabel, .cluster-label, .label { font-family: Arial, Helvetica, sans-serif !important; } .node, .node *, .cluster, .cluster * { filter: none !important; box-shadow: none !important; } .cluster-label, .cluster-label span, .cluster-label p { color: #023E7C !important; }'
  themeVariables:
    fontFamily: Arial, Helvetica, sans-serif
    fontSize: 26px
    primaryColor: '#FFFFFF'
    primaryTextColor: '#023E7C'
    primaryBorderColor: '#023E7C'
    lineColor: '#023E7C'
    secondaryColor: '#FFFFFF'
    tertiaryColor: '#FFFFFF'
    clusterBkg: '#FFFFFF'
    clusterBorder: '#023E7C'
    edgeLabelBackground: '#FFFFFF'
  flowchart:
    htmlLabels: true
    curve: linear
    nodeSpacing: 22
