%% C4 Level 2 - Containers (target: scalable modular monolith with load balancing)
flowchart TB
  classDef person fill:#EAF1FB,stroke:#023E7C,stroke-width:2px,color:#0B2545
  classDef cont fill:#FFFFFF,stroke:#023E7C,stroke-width:2px,color:#0B2545
  classDef hot fill:#FFF4E6,stroke:#F17D00,stroke-width:2px,color:#0B2545
  classDef db fill:#EAF1FB,stroke:#023E7C,stroke-width:2px,color:#0B2545

  U["👤 Five roles · web browser"]:::person
  SPA["<b>Single-page application</b> · React 19 + TypeScript<br/><small>runs in the browser · TanStack Query · OpenAPI-generated client</small>"]:::cont
  subgraph SERMS["SERMS system boundary"]
    EDGE["<b>Edge proxy</b> · host nginx + Let's Encrypt<br/><small>TLS 1.2/1.3 · HSTS · request rate limiting</small>"]:::cont
    WEB["<b>Web tier</b> · nginx container<br/><small>serves SPA static files · L7 load balancer for /api/* (least_conn, passive health checks)</small>"]:::hot
    subgraph POOL["Stateless application pool · N replicas (horizontal scaling)"]
      direction LR
      A1["<b>app-1</b><br/>Spring Boot 4<br/><small>REST /api/v1</small>"]:::cont
      A2["<b>app-2</b><br/>Spring Boot 4<br/><small>REST /api/v1</small>"]:::cont
      AN["<b>app-n</b><br/>Spring Boot 4<br/><small>REST /api/v1</small>"]:::cont
    end
    subgraph DATA["Data tier"]
      direction LR
      DB[("<b>PostgreSQL 18</b> primary<br/><small>schema serms · business data · audit<br/>spring_session · shedlock</small>")]:::db
      RR[("<b>Read replica</b><br/><small>reports · backups</small>")]:::db
      BK[("<b>Backup store</b><br/><small>daily pg_dump · 7-day retention</small>")]:::db
    end
  end
  MON["📈 Prometheus + Grafana<br/><small>metrics · alerts</small>"]:::cont

  U --> SPA
  SPA -- "HTTPS 443 · JSON · session cookie + X-XSRF-TOKEN" --> EDGE
  EDGE -- "HTTP 127.0.0.1:8789" --> WEB
  WEB -- "upstream app_pool" --> A1
  WEB --> A2
  WEB --> AN
  A1 -- "JDBC / HikariCP" --> DB
  A2 --> DB
  AN --> DB
  DB -- "streaming replication" --> RR
  RR -- "pg_dump" --> BK
  POOL -. "/actuator/prometheus" .-> MON
