@startdot
digraph UML {
// T3 UML class diagram. Render trusted source with PlantUML 1.2026.9 to SVG; rasterize to PNG.
// Wrapped identifiers concatenate to exact type names. Baseline df9033f.
// MaintenanceCase exists. Its state field/delegation here is a design model.
// MaintenanceState and five concrete state classes are absent from current Java.
graph [rankdir=LR,dpi=72,bgcolor=white,fontname="Arial",fontcolor="#023E7C",fontsize=22,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="24"><B>Maintenance case — State pattern (design model)</B></FONT></TD></TR><TR><TD>Terminal states reject all actions (D-008).</TD></TR><TR><TD><FONT COLOR="#F17D00"><B>invalid action →<BR/>InvalidMaintenanceTransitionException (HTTP 409)</B></FONT></TD></TR></TABLE>>,labelloc=t,pad=0.08,nodesep=0.11,ranksep=0.32,splines=polyline,newrank=true];
node [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C"];
edge [fontname="Arial",fontsize=22,fontcolor="#023E7C",color="#023E7C",arrowsize=0.8,penwidth=1.3];
context [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white"><TR><TD><I>«Context · design view»</I></TD></TR><TR><TD>MaintenanceCase</TD></TR><HR/><TR><TD ALIGN="LEFT">- status : MaintenanceStatus</TD></TR><TR><TD ALIGN="LEFT">- currentState : MaintenanceState</TD></TR></TABLE>>];
state [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD><I>«State · designed · interface»</I></TD></TR><TR><TD>MaintenanceState</TD></TR><HR/><TR><TD ALIGN="LEFT">+ assign(case, technicianId)</TD></TR><TR><TD ALIGN="LEFT">+ start(case)</TD></TR><TR><TD ALIGN="LEFT">+ resolve(case, note)</TD></TR><TR><TD ALIGN="LEFT">+ markUnrepairable(case, note)</TD></TR></TABLE>>];
subgraph cluster_states {label="«ConcreteState» «designed»"; color="#023E7C"; fontcolor="#023E7C"; fontsize=22; penwidth=1; margin=10;
open [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>OpenState</TD></TR></TABLE>>];
assigned [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>AssignedState</TD></TR></TABLE>>];
progress [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>InProgressState</TD></TR></TABLE>>];
resolved [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>ResolvedState</TD></TR></TABLE>>];
unrepairable [shape=plain,style=dashed,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#023E7C" BGCOLOR="white" STYLE="DASHED"><TR><TD>UnrepairableState</TD></TR></TABLE>>];
{rank=same; open; assigned; progress; resolved; unrepairable;}
open -> assigned -> progress -> resolved -> unrepairable [style=invis,weight=100];
}
{rank=same; context; state;}
context -> state [style=invis,weight=100];
context:s -> state:n [label="delegates",constraint=false];
state -> {open assigned progress resolved unrepairable} [dir=back,arrowtail=empty,style=dashed];


}
@enddot
